        variable_struct_set(translations, "Stone", "돌");
        variable_struct_set(translations, "Stone Bricks", "석재 벽돌");
        variable_struct_set(translations, "Stop playing after section", "구간 끝에서 재생 정지");
        variable_struct_set(translations, "Stop song", "재생 정지");
        variable_struct_set(translations, "Structure saved!", "구조물을 저장했습니다!");
        variable_struct_set(translations, "Successfully updated!", "업데이트를 완료했습니다!");
        variable_struct_set(translations, "Sustain:", "유지:");
        variable_struct_set(translations, "Tempo", "템포");
        variable_struct_set(translations, "Tempo changes", "템포 변경");
        variable_struct_set(translations, "Tempo of the song (measured in beats per minute).\nClick and drag to change. Click to enter value. Right-click for more options.", "곡의 템포 (분당 박자 수).\n드래그하여 변경, 클릭하여 입력, 우클릭하여 추가 옵션을 봅니다.");
        variable_struct_set(translations, "Tempo of the song (measured in ticks per second).\nClick and drag to change. Click to enter value. Right-click for more options.", "곡의 템포 (초당 틱 수).\n드래그하여 변경, 클릭하여 입력, 우클릭하여 추가 옵션을 봅니다.");
        variable_struct_set(translations, "Tempo tapper", "탭으로 템포 설정");
        variable_struct_set(translations, "Tempo tapper...", "탭으로 템포 설정...");
        variable_struct_set(translations, "Tempo unit", "템포 단위");
        variable_struct_set(translations, "Tempo:", "템포:");
        variable_struct_set(translations, "Terracotta", "테라코타");
        variable_struct_set(translations, "Thank you for upgrading to version ", "업데이트해 주셔서 감사합니다! 버전: ");
        variable_struct_set(translations, "The ID of the block that should be placed\nbelow note blocks of the instrument.", "이 악기의 소리 블록 아래에 놓을\n블록의 ID입니다.");
        variable_struct_set(translations, "The Schematic contained more than one input.\n\nAs a result, the songs of the inputs have been put after each other.", "스키매틱에 입력 장치가 여러 개 있습니다.\n\n각 입력의 곡을 순서대로 이어 붙였습니다.");
        variable_struct_set(translations, "The Schematic did not include any supported inputs.\nSupported inputs are:\n\n* Buttons\n* Levers", "지원하는 입력 장치가 없습니다.\n지원하는 입력 장치:\n\n* 버튼\n* 레버");
        variable_struct_set(translations, "The Schematic is too big. The maximum size is 2000x2000x256.\nTry changing the \"Repeaters per row\" value to decrease the size.", "스키매틱이 너무 큽니다. 최대 크기는 2000x2000x256입니다.\n\"행당 중계기 수\"를 조절하여 크기를 줄이세요.");
        variable_struct_set(translations, "The amount of events in the track.", "트랙의 이벤트 수입니다.");
        variable_struct_set(translations, "The amount of keys to show. A high number may\nslow down the program on old computers.", "표시할 건반 수입니다. 너무 많으면\n오래된 컴퓨터에서 느려질 수 있습니다.");
        variable_struct_set(translations, "The amount of minutes between each auto-save.", "자동 저장 간격 (분)입니다.");
        variable_struct_set(translations, "The amount of repeaters per row in\nthe Schematic. Click and drag to change.", "스키매틱의 행당 중계기 수입니다.\n드래그하여 변경합니다.");
        variable_struct_set(translations, "The amount of ticks between repetitions.", "반복 사이의 틱 간격입니다.");
        variable_struct_set(translations, "The block that should be used for the circuitry.", "회로에 사용할 블록입니다.");
        variable_struct_set(translations, "The block that should be used for the ground.\nChoosing grass will result with a bunch of animals spawning.", "바닥에 사용할 블록입니다.\n잔디를 선택하면 동물이 생성될 수 있습니다.");
        variable_struct_set(translations, "The block that should be used for the walkway, \nand everything else that isn't circuitry or ground.", "통로와 회로·바닥 외의\n부분에 사용할 블록입니다.");
        variable_struct_set(translations, "The default key pitch of the sound file.", "소리 파일의 기본 음 높이입니다.");
        variable_struct_set(translations, "The ending tick is larger than the song!\nThe size of the song is ", "끝 틱이 곡 길이를 넘습니다!\n곡 길이: ");
        variable_struct_set(translations, "The exported schematic is currently only compatible with Minecraft: Java Edition 1.12 and below. To import it in 1.13 and above, please use the export to structure block function.\n\nThis warning will never be shown again.", "스키매틱은 마인크래프트 자바 에디션 1.12 이하에서만 호환됩니다. 1.13 이상에서는 구조물 블록으로 내보내기를 사용하세요.\n\n이 경고는 다시 표시하지 않습니다.");
        variable_struct_set(translations, "The file for the specified asset index could not be found!", "지정한 에셋 목록 파일을 찾을 수 없습니다!");
        variable_struct_set(translations, "The following file(s) could not be found:", "다음 파일을 찾을 수 없습니다:");
        variable_struct_set(translations, "The following file(s) could not be found:\n\n", "다음 파일을 찾을 수 없습니다:\n\n");
        variable_struct_set(translations, "The indicated folder doesn't exist!", "지정한 폴더가 없습니다!");
        variable_struct_set(translations, "The instrument that note block added by this device\nwhen recording should have.", "녹음 중 이 장치로 입력한 음표에\n사용할 악기입니다.");
        variable_struct_set(translations, "The instrument the notes in the channel\nshould be translated to.", "이 채널의 음표에 사용할\n악기입니다.");
        variable_struct_set(translations, "The instrument the sound\nshould be translated to.", "이 소리에 사용할\n악기입니다.");
        variable_struct_set(translations, "The maximum allowed layers per channel.\nClick and drag to adjust.", "채널당 최대 레이어 수입니다.\n드래그하여 조절합니다.");
        variable_struct_set(translations, "The name for this layer", "이 레이어의 이름");
        variable_struct_set(translations, "The name of the block that should be\nplaced below note blocks of the instrument.", "이 악기의 소리 블록 아래에 놓을\n블록의 이름입니다.");
        variable_struct_set(translations, "The name of the creator of the original song\n(Leave empty if you composed the song yourself.)", "원곡 작곡가의 이름입니다.\n(직접 작곡한 경우 비워 두세요.)");
        variable_struct_set(translations, "The name of the creator of the song.", "곡 제작자의 이름입니다.");
        variable_struct_set(translations, "The name of the device.", "장치 이름입니다.");
        variable_struct_set(translations, "The name of the instrument.", "악기 이름입니다.");
        variable_struct_set(translations, "The name of the patch (instrument) of the channel.", "채널의 악기 이름입니다.");
        variable_struct_set(translations, "The name of the song.", "곡 이름입니다.");
        variable_struct_set(translations, "The name of the sound.", "소리 이름입니다.");
        variable_struct_set(translations, "The name of the track.", "트랙 이름입니다.");
        variable_struct_set(translations, "The name of this instrument.", "이 악기의 이름입니다.");
        variable_struct_set(translations, "The name of this layer.", "이 레이어의 이름입니다.");
        variable_struct_set(translations, "The note which represents the sound.", "소리를 나타내는 음표입니다.");
        variable_struct_set(translations, "The number of the channel.", "채널 번호입니다.");
        variable_struct_set(translations, "The number of the track.", "트랙 번호입니다.");
        variable_struct_set(translations, "The octave modifier for all sounds in this channel.", "이 채널의 모든 소리에 적용할 옥타브 조정 값입니다.");
        variable_struct_set(translations, "The patch (instrument) of the channel.", "채널의 프로그램 (악기)입니다.");
        variable_struct_set(translations, "The pitch of the output.", "출력할 음정입니다.");
        variable_struct_set(translations, "The song could not be downloaded! Please try again with a different song.", "곡을 다운로드하지 못했습니다! 다른 곡으로 다시 시도하세요.");
        variable_struct_set(translations, "The song could not be saved!", "곡을 저장하지 못했습니다!");
        variable_struct_set(translations, "The sound file for this instrument cannot be changed.", "이 악기의 소리 파일은 변경할 수 없습니다.");
        variable_struct_set(translations, "The sound file of this instrument.", "이 악기의 소리 파일입니다.");
        variable_struct_set(translations, "The tempo is ", "템포: ");
        variable_struct_set(translations, "The tempo must be either 2.5, 5 or 10 ticks per second.", "템포는 초당 2.5, 5 또는 10틱이어야 합니다.");
        variable_struct_set(translations, "The tempo of the song is not compatible with Minecraft. As a result, the playback speed of the song in-game will differ from the one in the program.", "마인크래프트와 호환되지 않는 템포입니다. 게임에서의 재생 속도가 프로그램과 달라집니다.");
        variable_struct_set(translations, "The time signature of the song.", "곡의 박자표입니다.");
        variable_struct_set(translations, "Theme", "테마");
        variable_struct_set(translations, "There are ", "총 ");
        variable_struct_set(translations, "There are more custom instruments in the pattern than what is loaded in the song!", "패턴에 곡보다 많은 사용자 지정 악기가 있습니다!");
        variable_struct_set(translations, "There are no blocks outside the 2 octave range.", "2옥타브 범위를 벗어난 블록이 없습니다.");
        variable_struct_set(translations, "There are no blocks to export!", "내보낼 블록이 없습니다!");
        variable_struct_set(translations, "There are no blocks with custom instruments.", "사용자 지정 악기를 쓰는 블록이 없습니다.");
        variable_struct_set(translations, "There is 1 block outside the 2 octave range.", "2옥타브 범위를 벗어난 블록이 1개 있습니다.");
        variable_struct_set(translations, "There is 1 block with custom instruments.", "사용자 지정 악기를 쓰는 블록이 1개 있습니다.");
        variable_struct_set(translations, "There is an update available!", "새 업데이트가 있습니다!");
        variable_struct_set(translations, "There must be exactly two layers worth of note blocks in every applicable tick!", "적용할 각 틱에 소리 블록이 정확히 두 레이어에 있어야 합니다!");
        variable_struct_set(translations, "There was an error when saving as MP3.\nError code: ", "MP3 저장 중 오류가 발생했습니다.\n오류 코드: ");
        variable_struct_set(translations, "These settings only apply to this song. To import the settings from another\nsong, click \"Import\". The sound files must be located in the \"Sounds\" folder.", "이 설정은 현재 곡에만 적용됩니다. 다른 곡의 설정을 불러오려면\n\"가져오기\"를 누르세요. 소리 파일은 \"Sounds\" 폴더에 있어야 합니다.");
        variable_struct_set(translations, "This file does not contain any custom instruments.", "이 파일에는 사용자 지정 악기가 없습니다.");
        variable_struct_set(translations, "This file doesn't look like a valid song!", "올바른 곡 파일이 아닌 것 같습니다!");
        variable_struct_set(translations, "This file is too large to be opened via a URL! Please try downloading and manually opening the song.", "URL로 열기에는 파일이 너무 큽니다! 다운로드한 뒤 직접 열어 주세요.");
        variable_struct_set(translations, "This may replace \nlower note blocks!", "아래쪽 소리 블록이\n덮어써질 수 있습니다!");
        variable_struct_set(translations, "This message is shown when the file is opened.", "파일을 열 때 이 메시지가 표시됩니다.");
        variable_struct_set(translations, "This name will be used in the command", "명령에 사용할 이름입니다");
        variable_struct_set(translations, "This song contains more than 18 instruments and cannot be saved in version ", "악기가 18개를 초과하여 다음 버전으로 저장할 수 없습니다: ");
        variable_struct_set(translations, "This song is compatible with both schematics and data packs.\n(Click for more info.)", "스키매틱과 데이터 팩에 모두 호환되는 곡입니다.\n(클릭하면 자세히 보기)");
        variable_struct_set(translations, "This song is compatible with data packs using a resource pack.\n(Click for more info.)", "리소스 팩을 사용하는 데이터 팩에 호환되는 곡입니다.\n(클릭하면 자세히 보기)");
        variable_struct_set(translations, "This song is only compatible with data packs.\n(Click for more info.)", "데이터 팩에만 호환되는 곡입니다.\n(클릭하면 자세히 보기)");
        variable_struct_set(translations, "This song uses custom instruments. However, some sounds could not be loaded:", "이 곡은 사용자 지정 악기를 사용하지만 다음 소리를 불러오지 못했습니다:");
        variable_struct_set(translations, "This song uses custom instruments. However, some sounds could not be loaded:\n\n", "이 곡은 사용자 지정 악기를 사용하지만 다음 소리를 불러오지 못했습니다:\n\n");
        variable_struct_set(translations, "This sound file could not be found.", "이 소리 파일을 찾을 수 없습니다.");
        variable_struct_set(translations, "This will remove ", "삭제할 항목 수: ");
        variable_struct_set(translations, "Tick by tick", "틱 단위");
        variable_struct_set(translations, "Tick the song will jump to at the end of playback", "재생이 끝나면 돌아갈 틱");
        variable_struct_set(translations, "Tick: ", "틱: ");
        variable_struct_set(translations, "Ticks per second (t/s)", "초당 틱 수 (t/s)");
        variable_struct_set(translations, "Ticks per second (t/s)|", "초당 틱 수 (t/s)|");
        variable_struct_set(translations, "Time precision", "시간 정밀도");
        variable_struct_set(translations, "Time signature:", "박자표:");
        variable_struct_set(translations, "Times to loop:", "반복 횟수:");
        variable_struct_set(translations, "Tip: click the tempo box\nto enter a value!", "팁: 템포 상자를 클릭하면\n값을 입력할 수 있습니다!");
        variable_struct_set(translations, "To play the song in-game, use:", "게임에서 곡을 재생하려면 다음 명령을 사용하세요:");
        variable_struct_set(translations, "To play the song in-game, use: ", "게임에서 곡을 재생하려면 다음 명령을 사용하세요: ");
        variable_struct_set(translations, "To play the song using a command block or function, use:", "명령 블록이나 함수로 재생하려면 다음 명령을 사용하세요:");
        variable_struct_set(translations, "To play without one, all blocks must be within Minecraft's 2 octave range.", "리소스 팩 없이 재생하려면 모든 블록이 2옥타브 범위 안에 있어야 합니다.");
        variable_struct_set(translations, "To play without one, no custom instruments must be used.", "리소스 팩 없이 재생하려면 사용자 지정 악기를 사용할 수 없습니다.");
        variable_struct_set(translations, "Toggle looping", "반복 재생 전환");
