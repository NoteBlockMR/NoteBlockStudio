        variable_struct_set(translations, "Use different shapes for each instrument", "악기별 모양 사용");
        variable_struct_set(translations, "Use flat symbol", "플랫 기호 사용");
        variable_struct_set(translations, "Use more audio channels", "오디오 채널 확장");
        variable_struct_set(translations, "Use mouse wheel to change instrument", "휠로 악기 변경");
        variable_struct_set(translations, "Use mouse wheel to change key", "휠로 음 높이 변경");
        variable_struct_set(translations, "Use mouse wheel to scroll through the song", "휠로 곡 스크롤");
        variable_struct_set(translations, "Use selected", "선택한 값 사용");
        variable_struct_set(translations, "Use selected|-|", "선택한 값 사용|-|");
        variable_struct_set(translations, "Use the mouse wheel to scroll through\nthe song horizontally or vertically.", "마우스 휠로 곡을\n가로나 세로로 스크롤합니다.");
        variable_struct_set(translations, "Use the mouse wheel to toggle between\nthe available instruments.", "마우스 휠로\n악기를 변경합니다.");
        variable_struct_set(translations, "Use the mouse wheel to toggle\nbetween the keys on the piano.", "마우스 휠로\n피아노의 음 높이를 변경합니다.");
        variable_struct_set(translations, "Using a resource pack, you may extend the supported range to 6 octaves.", "리소스 팩을 사용하면 음역을 6옥타브로 확장할 수 있습니다.");
        variable_struct_set(translations, "Using a resource pack, you may play custom instruments in Minecraft.", "리소스 팩을 사용하면 마인크래프트에서 사용자 지정 악기를 재생할 수 있습니다.");
        variable_struct_set(translations, "Values must be between 1 and 100.", "값은 1~100 사이여야 합니다.");
        variable_struct_set(translations, "Velocity", "세기");
        variable_struct_set(translations, "Velocity: ", "세기: ");
        variable_struct_set(translations, "Version ", "버전 ");
        variable_struct_set(translations, "Version Local Release", "로컬 빌드 버전");
        variable_struct_set(translations, "Vibrato", "비브라토");
        variable_struct_set(translations, "Vibrato|", "비브라토|");
        variable_struct_set(translations, "View all", "모두 보기");
        variable_struct_set(translations, "View song info", "곡 정보 보기");
        variable_struct_set(translations, "Visit the Note Block Studio website", "Note Block Studio 웹사이트 방문");
        variable_struct_set(translations, "Visualizer", "시각 효과");
        variable_struct_set(translations, "Visualizer type", "시각 효과 유형");
        variable_struct_set(translations, "Volume LFO", "음량 LFO");
        variable_struct_set(translations, "Volume LFO|", "음량 LFO|");
        variable_struct_set(translations, "Volume of this layer: ", "레이어 음량: ");
        variable_struct_set(translations, "Warning", "경고");
        variable_struct_set(translations, "Warning: You are opening an NBP file created in a later version of Note Block Studio. It may crash when opening.", "더 최신 버전에서 만든 NBP 파일입니다. 여는 중 오류가 발생할 수 있습니다.");
        variable_struct_set(translations, "Warning: You are opening an NBS file created in a later version of Note Block Studio.\nPlease save the song as a version ", "더 최신 버전의 Note Block Studio에서 만든 NBS 파일입니다.\n저장 옵션에서 다음 버전 이하로 저장하세요: ");
        variable_struct_set(translations, "Warning: You are opening an older NBP file. Saving this file will make it incompatible with older Note Block Studio versions.", "이전 형식의 NBP 파일입니다. 저장하면 이전 버전의 Note Block Studio에서 열 수 없게 됩니다.");
        variable_struct_set(translations, "Warning: You are opening an older NBS file. Saving this file will make it incompatible with older Note Block Studio versions.", "이전 형식의 NBS 파일입니다. 저장하면 이전 버전의 Note Block Studio에서 열 수 없게 됩니다.");
        variable_struct_set(translations, "Watch release video", "출시 동영상 보기");
        variable_struct_set(translations, "Watch tutorial videos", "사용법 동영상 보기");
        variable_struct_set(translations, "Way to go!", "잘하셨습니다!");
        variable_struct_set(translations, "Website", "웹사이트");
        variable_struct_set(translations, "Website...", "웹사이트...");
        variable_struct_set(translations, "Website...|GitHub...|Discord server...|Report a bug...|Donate...|-|Changelist...|About...", "웹사이트...|GitHub...|Discord 서버...|버그 신고...|후원...|-|변경 내역...|프로그램 정보...");
        variable_struct_set(translations, "What do you want to do?", "무엇을 하시겠습니까?");
        variable_struct_set(translations, "Whether a glass floor should\nmake all the note blocks visible.", "모든 소리 블록이 보이도록\n유리 바닥을 만듭니다.");
        variable_struct_set(translations, "Whether notes of this type should be\npressed when the marker reaches them.", "마커가 도달하면 이 유형의\n음표를 재생합니다.");
        variable_struct_set(translations, "Whether scrolling when hovering over a note should change its key,\nvelocity, panning or pitch, according to the currently selected edit mode.", "음표 위에서 휠을 굴리면 현재 편집 모드에 따라\n음 높이, 세기, 패닝 또는 미세 음정을 변경합니다.");
        variable_struct_set(translations, "Whether the layer boxes should be shown\non the left side of the workspace.", "작업 영역 왼쪽에\n레이어 상자를 표시합니다.");
        variable_struct_set(translations, "Whether the number of the octave the note block\nis in should be shown.", "소리 블록의 옥타브\n번호를 표시합니다.");
        variable_struct_set(translations, "Whether the piano should be visible.", "피아노 건반을 표시합니다.");
        variable_struct_set(translations, "Whether the song should automatically\nbe saved every now and then.", "일정한 간격으로 곡을\n자동 저장합니다.");
        variable_struct_set(translations, "Whether to add a chest full of minecarts\nat the beginning of the song.", "곡 시작 지점에 광산 수레가 담긴\n상자를 추가합니다.");
        variable_struct_set(translations, "Whether to add a glowing effect to each note block.", "소리 블록에 빛나는 효과를 추가합니다.");
        variable_struct_set(translations, "Whether to add a lever that toggles looping.", "반복 재생 전환 레버를 추가합니다.");
        variable_struct_set(translations, "Whether to add tempo changes found in the MIDI file.\nTempo changes are not supported in-game and in most NBS-compatible tools.", "MIDI 파일의 템포 변경을 가져옵니다.\n게임과 대부분의 NBS 도구는 템포 변경을 지원하지 않습니다.");
        variable_struct_set(translations, "Whether to always start playing\nat the start of the active section.", "항상 활성 구간의\n시작부터 재생합니다.");
        variable_struct_set(translations, "Whether to automatically transpose the notes\nto keep them within the 2 octave range.", "음표를 자동으로 조옮김하여\n2옥타브 범위 안에 맞춥니다.");
        variable_struct_set(translations, "Whether to check for any updates\nwhen the program is opened.", "프로그램 시작 시\n업데이트를 확인합니다.");
        variable_struct_set(translations, "Whether to check for development versions in addition to stable releases.\nDevelopment versions contain the latest improvements, but may be potentially unstable.", "안정 버전 외에 개발 버전도 확인합니다.\n개발 버전에는 최신 개선 사항이 있지만 불안정할 수 있습니다.");
        variable_struct_set(translations, "Whether to copy the volume data found\nin each MIDI note.", "MIDI 음표의 세기 데이터를\n가져옵니다.");
        variable_struct_set(translations, "Whether to display info about your current\nsong in your Discord status activity.", "현재 곡 정보를 Discord\n활동 상태에 표시합니다.");
        variable_struct_set(translations, "Whether to display the song\nprogress on the taskbar.", "작업 표시줄에 곡의\n재생 진행률을 표시합니다.");
        variable_struct_set(translations, "Whether to export locked layers in the audio track.", "잠긴 레이어도 오디오에 포함합니다.");
        variable_struct_set(translations, "Whether to export the data pack as a ZIP file.", "데이터 팩을 ZIP 파일로 내보냅니다.");
        variable_struct_set(translations, "Whether to export the ground, repeaters, and redstone.", "바닥, 중계기와 레드스톤을 내보냅니다.");
        variable_struct_set(translations, "Whether to include locked layers in the Schematic.", "잠긴 레이어도 스키매틱에 포함합니다.");
        variable_struct_set(translations, "Whether to include locked layers in the data pack.", "잠긴 레이어도 데이터 팩에 포함합니다.");
        variable_struct_set(translations, "Whether to include notes that don't fall into the 2 octave range supported by", "마인크래프트의 2옥타브 범위 밖 음표도 포함합니다.");
        variable_struct_set(translations, "Whether to increase the number\nof sounds that can play at once.", "동시에 재생할 수 있는\n소리 수를 늘립니다.");
        variable_struct_set(translations, "Whether to let all players in a given", "지정한 범위의 모든 플레이어가");
        variable_struct_set(translations, "Whether to loop this song back to", "재생이 끝나면 곡을");
        variable_struct_set(translations, "Whether to play sound effects when navigating the interface.\n(Only applies to the Fluent theme.)", "인터페이스 조작 시 효과음을 재생합니다.\n(Fluent 테마 전용)");
        variable_struct_set(translations, "Whether to position the note blocks differently due to their velocity.\nIt's recommended that each layer's velocity should be the same when polyphony is higher than 1.", "세기에 따라 소리 블록 위치를 조정합니다.\n동시 발음 수가 1보다 크면 레이어별 세기를 같게 설정하는 것이 좋습니다.");
        variable_struct_set(translations, "Whether to remove any silent parts\nat the beginning of the song.", "곡 시작 부분의\n무음 구간을 제거합니다.");
        variable_struct_set(translations, "Whether to show a fading border\nwhen removing a note block.", "소리 블록을 삭제할 때\n사라지는 테두리 효과를 표시합니다.");
        variable_struct_set(translations, "Whether to show a note chart\nwhen hovering over the keys.", "건반에 마우스를 올리면\n음표 표를 표시합니다.");
        variable_struct_set(translations, "Whether to show a red outline on note blocks with\ncustom instruments or outside the 2 octave range.", "사용자 지정 악기나 2옥타브 범위를 벗어난\n소리 블록에 빨간 테두리를 표시합니다.");
        variable_struct_set(translations, "Whether to show a red tint on keys\noutside of the 2 octave range.", "2옥타브 범위를 벗어난 건반을\n빨간색으로 표시합니다.");
        variable_struct_set(translations, "Whether to show a warning when opening a song\nsaved in an older version of Note Block Studio.", "이전 버전의 Note Block Studio에서\n저장한 곡을 열 때 경고합니다.");
        variable_struct_set(translations, "Whether to show the amount of right-clicks required\nfor each note block.", "소리 블록의 음을 맞추는 데 필요한\n우클릭 횟수를 표시합니다.");
        variable_struct_set(translations, "Whether to show the amount of right-clicks required\non each key inside the 2 octave range.", "2옥타브 범위 내 각 건반에\n필요한 우클릭 횟수를 표시합니다.");
        variable_struct_set(translations, "Whether to show the greeting window\nwhen the program is opened.", "프로그램을 시작할 때\n시작 화면을 표시합니다.");
        variable_struct_set(translations, "Whether to show the volume of layers.", "레이어의 음량을 표시합니다.");
        variable_struct_set(translations, "Whether to show transparency effects on the interface.\n(Only applies to the Fluent theme.)", "인터페이스에 투명 효과를 사용합니다.\n(Fluent 테마 전용)");
        variable_struct_set(translations, "Whether to stop playing when the\nmarker passes the active section.", "마커가 활성 구간을 지나면\n재생을 멈춥니다.");
        variable_struct_set(translations, "Whether to use command blocks instead of note blocks for a wider octave range.\n(Extra notes pack required)", "소리 블록 대신 명령 블록으로 음역을 넓힙니다.\n(추가 음역 팩 필요)");
        variable_struct_set(translations, "Whether to use darker colors on the interface.\n(Only applies to the Fluent theme.)", "인터페이스에 어두운 색을 사용합니다.\n(Fluent 테마 전용)");
        variable_struct_set(translations, "Whether to use higher resolution textures on the interface.\n", "인터페이스에 고해상도 텍스처를 사용합니다.\n");
        variable_struct_set(translations, "Whether to use the flat symbol (b) instead of\nthe sharp symbol (#) on keynames.", "음 이름에 샤프 (#) 대신\n플랫 (b) 기호를 사용합니다.");
        variable_struct_set(translations, "Whether to use these settings the\nnext time you export a Schematic.", "다음에 스키매틱을 내보낼 때도\n이 설정을 사용합니다.");
        variable_struct_set(translations, "Whether to use these settings the\nnext time you export a branch.", "다음에 분기를 내보낼 때도\n이 설정을 사용합니다.");
        variable_struct_set(translations, "Whether to use these settings the\nnext time you export a data pack.", "다음에 데이터 팩을 내보낼 때도\n이 설정을 사용합니다.");
        variable_struct_set(translations, "Whether to use these settings the\nnext time you import a MIDI file.", "다음에 MIDI 파일을 가져올 때도\n이 설정을 사용합니다.");
        variable_struct_set(translations, "White", "흰색");
        variable_struct_set(translations, "Window", "창");
        variable_struct_set(translations, "Window scale", "창 배율");
        variable_struct_set(translations, "Wood", "나무");
        variable_struct_set(translations, "Wood (Acacia / Dark Oak)", "나무 (아카시아 / 짙은 참나무)");
        variable_struct_set(translations, "Wood Planks", "나무 판자");
        variable_struct_set(translations, "Wooden Slab", "나무 반 블록");
        variable_struct_set(translations, "Wool", "양털");
        variable_struct_set(translations, "Wool|\\|", "양털|\\|");
        variable_struct_set(translations, "Work stats", "작업 통계");
        variable_struct_set(translations, "X value", "X 좌표");
        variable_struct_set(translations, "X value:", "X 좌표:");
        variable_struct_set(translations, "Xylophone", "실로폰");
        variable_struct_set(translations, "Yellow", "노란색");
        variable_struct_set(translations, "Yes", "예");
        variable_struct_set(translations, "Yes|", "예|");
        variable_struct_set(translations, "You are using the latest version!", "최신 버전을 사용 중입니다!");
        variable_struct_set(translations, "You're currently running a development version of Note Block Studio. By disabling this option, you will be prompted to downgrade to the latest stable version the next time you open the program.\n\nProceed?", "현재 개발 버전을 사용 중입니다. 이 옵션을 끄면 다음 실행 시 최신 안정 버전으로 변경할지 묻습니다.\n\n계속할까요?");
        variable_struct_set(translations, "Z value", "Z 좌표");
        variable_struct_set(translations, "Z value:", "Z 좌표:");
        variable_struct_set(translations, "ZIP archive (*.zip)|*.zip", "ZIP 압축 파일 (*.zip)|*.zip");
        variable_struct_set(translations, "\n(Click and drag to change)", "\n(드래그하여 변경)");
        variable_struct_set(translations, "\nMake sure that you have put the sounds in the \"Sounds\" folder. Open Instrument settings?", "\n소리 파일이 \"Sounds\" 폴더에 있는지 확인하세요. 악기 설정을 열까요?");
        variable_struct_set(translations, "\nWould you like to export anyway?", "\n그래도 내보낼까요?");
        variable_struct_set(translations, "\n\nSome sounds might not play.", "\n\n일부 소리가 재생되지 않을 수 있습니다.");
        variable_struct_set(translations, "\n\nThis program is a continuation of\n Minecraft Note Block Studio, \ncreated by David Andrei. \n\nThis product is not affiliated with\nMojang Studios, Microsoft Studios\nor the game Minecraft.", "\n\n이 프로그램은 David Andrei가 만든\nMinecraft Note Block Studio의\n후속 프로젝트입니다.\n\nMojang Studios, Microsoft Studios 및\n마인크래프트와 공식적인 관련이 없습니다.");
        variable_struct_set(translations, "^!No recent songs", "^!최근 곡 없음");
        variable_struct_set(translations, "and then remove it from the ", "그런 다음 다음 폴더에서 삭제하세요: ");
        variable_struct_set(translations, "and then remove it from the 'datapacks' folder.", "그런 다음 'datapacks' 폴더에서 삭제하세요.");
        variable_struct_set(translations, "beats per minute", "분당 박자 수");
        variable_struct_set(translations, "end of playback instead of stopping.", "끝나도 멈추지 않고 반복됩니다.");
        variable_struct_set(translations, "file has been restored.", "개 파일을 복구했습니다.");
        variable_struct_set(translations, "files have been restored.", "개 파일을 복구했습니다.");
        variable_struct_set(translations, "folder. You can use '/' to add subfolders.", "폴더 내 경로입니다. '/'로 하위 폴더를 지정할 수 있습니다.");
        variable_struct_set(translations, "for playing the song inside the game.", "게임에서 곡을 재생할 때 사용합니다.");
        variable_struct_set(translations, "original by ", "원작: ");
        variable_struct_set(translations, "radius hear the music as well.", "음악을 함께 들을 수 있게 합니다.");
        variable_struct_set(translations, "s were", "를");
        variable_struct_set(translations, "sounds from that version!", "선택한 버전의 소리를 가져옵니다!");
        variable_struct_set(translations, "t/s (T to tap)", "t/s (T로 박자 입력)");
        variable_struct_set(translations, "the Minecraft Launcher.", "마인크래프트 런처에서 실행해야 합니다.");
        variable_struct_set(translations, "the start at the end of playback.", "처음부터 다시 재생합니다.");
        variable_struct_set(translations, "ticks per second", "초당 틱 수");
        variable_struct_set(translations, "your world, run: ", "월드에서 실행하세요: ");
    }
    if (variable_struct_exists(translations, text)) return variable_struct_get(translations, text);
    return text;
}
