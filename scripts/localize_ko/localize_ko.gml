        variable_struct_set(translations, "Tutorial videos|\\|Part 1: Composing note block music|Part 2: Opening MIDI files|Part 3: Importing songs into Minecraft|Part 4: Editing songs made in Minecraft     |-|F1$View all|/|-|", "사용법 동영상|\\|1부: 소리 블록 음악 작곡|2부: MIDI 파일 열기|3부: 마인크래프트에 곡 가져오기|4부: 마인크래프트에서 만든 곡 편집     |-|F1$모두 보기|/|-|");
        variable_struct_set(translations, "Undo the last change", "마지막 변경 취소");
