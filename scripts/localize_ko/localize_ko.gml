        variable_struct_set(translations, "Transpose notes so that they fall within Minecraft's 2 octaves?", "음표를 마인크래프트의 2옥타브 범위 안으로 조옮김할까요?");
        variable_struct_set(translations, "Transpose one octave down", "한 옥타브 내리기");
